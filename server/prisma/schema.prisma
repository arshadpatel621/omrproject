// Prisma schema for OMR backend using PostgreSQL
// Set DATABASE_URL in server/.env, e.g.:
// postgresql://USER:PASSWORD@localhost:5432/omrdb?schema=public

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  TEACHER
}

enum SubmissionStatus {
  PENDING
  PROCESSING
  COMPLETE
  REVIEW_REQUIRED
  ERROR
}

model User {
  id           Int      @id @default(autoincrement())
  email        String   @unique
  passwordHash String
  role         Role
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Test {
  id          Int      @id @default(autoincrement())
  name        String
  subject     String
  date        DateTime
  published   Boolean  @default(false)
  markCorrect Int      @default(1)
  markWrong   Int      @default(0)
  markBlank   Int      @default(0)
  versions    TestVersion[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model TestVersion {
  id         Int       @id @default(autoincrement())
  code       String
  test       Test      @relation(fields: [testId], references: [id])
  testId     Int
  answerKey  AnswerKey?
  submissions Submission[]

  @@unique([testId, code])
}

model AnswerKey {
  id        Int        @id @default(autoincrement())
  version   TestVersion @relation(fields: [versionId], references: [id])
  versionId Int        @unique
  questions Int
  answers   Json       // ["A","B","C","D","N"] by index
}

model Submission {
  id                Int               @id @default(autoincrement())
  test              Test              @relation(fields: [testId], references: [id])
  testId            Int
  version           TestVersion       @relation(fields: [versionId], references: [id])
  versionId         Int
  studentIdentifier String?
  imageUrl          String
  status            SubmissionStatus  @default(PENDING)
  score             Int?
  answers           Answer[]
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
}

model Answer {
  id            Int         @id @default(autoincrement())
  submission    Submission  @relation(fields: [submissionId], references: [id])
  submissionId  Int
  questionNumber Int
  selected      String?
  correct       Boolean?
}
